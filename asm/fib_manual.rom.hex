// fib_manual.rom.hex — задание на «3»: Фибоначчи, составлено вручную в машинных кодах.
// Формат строки: слово команды (hex) // адрес: разбор битовых полей.
// I-формат: op[15:12] rd[11:9] rs1[8:6] imm6[5:0]
// R-формат: op[15:12] rd[11:9] rs1[8:6] rs2[5:3] funct[2:0]
2200 // 0: 0010 001 000 000000  LW   R1, 0(R0)    R1 = N
1400 // 1: 0001 010 000 000000  ADDI R2, R0, 0    a = 0
1601 // 2: 0001 011 000 000001  ADDI R3, R0, 1    b = 1
4205 // 3: 0100 001 000 000101  BEQ  R1, R0, +5   -> 9 (3 + 1 + 5)
0898 // 4: 0000 100 010 011 000 ADD  R4, R2, R3   t = a + b
04c0 // 5: 0000 010 011 000 000 ADD  R2, R3, R0   a = b
0700 // 6: 0000 011 100 000 000 ADD  R3, R4, R0   b = t
127f // 7: 0001 001 001 111111  ADDI R1, R1, -1   N = N - 1
403a // 8: 0100 000 000 111010  BEQ  R0, R0, -6   -> 3 (8 + 1 - 6)
3401 // 9: 0011 010 000 000001  SW   R2, 1(R0)    RAM[1] = a
f000 // 10: 1111 000000000000   HALT
